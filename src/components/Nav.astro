---
const { pathname } = Astro.url;
const links = [
  { href: '/', label: 'Bio' },
  { href: '/research', label: 'Research' },
  { href: '/sharing', label: 'Sharing' },
  { href: '/writing', label: 'Writing' },
];
const isOn = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<nav class="nav">
  <div class="wrap navin">
    <a class="logo" href="/">KYAW&nbsp;YE&nbsp;THU</a>
    <div class="links">
      {links.map(l => <a href={l.href} class={isOn(l.href) ? 'on' : ''}>{l.label}</a>)}
      <a class="cv" href="/files/kyawyethu-cv.pdf">CV</a>
    </div>
    <details class="mmenu">
      <summary aria-label="Menu">☰</summary>
      <div class="mlinks">
        {links.map(l => <a href={l.href} class={isOn(l.href) ? 'on' : ''}>{l.label}</a>)}
        <a class="cv" href="/files/kyawyethu-cv.pdf">CV</a>
      </div>
    </details>
  </div>
</nav>
<style>
  .nav{position:sticky;top:0;z-index:5;background:rgba(247,246,243,.85);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  .navin{position:relative;display:flex;justify-content:space-between;align-items:center;padding:16px 24px}
  .logo{font-size:12px;letter-spacing:.2em;font-weight:700;color:var(--ink)}
  .links{display:flex;gap:20px;font-size:11px;letter-spacing:.06em;color:var(--muted);align-items:center}
  .links a{color:var(--muted)} .links a.on{color:var(--ink)}
  .cv{border:1px solid var(--ink);color:var(--ink)!important;padding:5px 13px;border-radius:20px;font-size:10px;letter-spacing:.08em;text-transform:uppercase}
  .mmenu{display:none}
  @media (max-width:720px){
    .logo{font-size:11px}
    .links{display:none}
    .mmenu{display:block}
    .mmenu summary{
      list-style:none;cursor:pointer;
      width:30px;height:30px;display:flex;align-items:center;justify-content:center;
      font-size:17px;color:var(--ink);
    }
    .mmenu summary::-webkit-details-marker{display:none}
    .mlinks{
      position:absolute;top:100%;left:0;right:0;
      display:flex;flex-direction:column;
      background:rgba(247,246,243,.85);backdrop-filter:blur(8px);
      border-bottom:1px solid var(--line);
      padding:4px 24px 18px;
    }
    .mlinks a{color:var(--muted);font-size:12px;letter-spacing:.06em;padding:10px 0}
    .mlinks a.on{color:var(--ink)}
    .mlinks .cv{align-self:flex-start;margin-top:8px;padding:5px 13px}
  }
</style>
